---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.svelte';

import heroData from '../data/hero.json';
const heroImages = heroData.images;

// Fetch all blog posts and sort by date descending
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Formatter for publication date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title="Home" description="Welcome to Tudorfer Kulturverein - your community portal for arts, culture, and events. Browse our latest blog posts and club updates.">
  <main>
    <!-- Hero Section -->
    <section class="hero" style="padding-bottom: 0;">
      <div class="hero-glow"></div>
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <span class="hero-tag">Willkommen beim TUKUJU</span>
        <h1 class="hero-title" style="margin-bottom: 0.25rem;">Tudorfer Kulturverein</h1>
        <div style="font-family: var(--font-body); font-size: 1.1rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem;">
          für junge Unterhaltung e.V.
        </div>
        <p class="hero-description" style="margin-bottom: 0;">
          Alles rund um Karneval! Erlebe die lustigsten Witze, die spannensten Sketche und die torpedotastischten Tanzeinlagen.
        </p>
      </div>
      <div style="width: 100%; position: relative; z-index: 2;">
        <HeroCarousel client:load images={heroImages} />
      </div>
    </section>

    <!-- Blog Section -->
    <section id="blog-section" class="container section-padding">
      <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem;">
        <h2 style="margin-bottom: 1rem;">Aktuelles</h2>
        <p>Bleibe auf dem Laufenden über die neuesten Projekte, Veranstaltungen und Ankündigungen unseres Vereins.</p>
      </div>

      {sortedPosts.length === 0 ? (
        <p style="text-align: center; color: var(--color-text-light); font-style: italic; margin-top: 3rem;">
          Momentan sind keine Blogeinträge vorhanden.
        </p>
      ) : (
        <div class="blog-grid">
          {sortedPosts.map((post) => (
            <article class="blog-card">
              <div class="blog-date">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {formatDate(post.data.date)}
              </div>
              <h3 class="blog-card-title">{post.data.title}</h3>
              <p class="blog-card-excerpt">{post.data.description}</p>
              <a href={`${import.meta.env.BASE_URL}blog/${post.id}`} class="blog-read-more">
                Artikel lesen
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    background-color: #0f172a;
    color: white;
    overflow: hidden;
    padding: 0;
    /* border-bottom-left-radius: var(--radius-lg); */
    /* border-bottom-right-radius: var(--radius-lg); */
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, #0f172a 100%);
    z-index: 1;
  }

  .hero-glow {
    position: absolute;
    width: 40vw;
    height: 40vw;
    background: radial-gradient(circle, rgba(from var(--color-accent) r g b / 0.3) 0%, rgba(from var(--color-accent) r g b / 0) 70%);
    top: -10vw;
    right: -10vw;
    z-index: 0;
    border-radius: var(--radius-full);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    text-align: center;
    margin: 20vw auto;
  }

  .hero-tag {
    display: inline-block;
    background-color: rgba(79, 70, 229, 0.2);
    border: 1px solid rgba(79, 70, 229, 0.4);
    color: #a5b4fc;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    color: white;
    margin-bottom: 1.5rem;
    background: linear-gradient(to right, #ffffff, #e2e8f0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.25rem;
    color: #94a3b8;
    margin-bottom: 2rem;
  }

  /* Blog List Card Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .blog-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
    position: relative;
    overflow: hidden;
  }

  .blog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 0;
    background: var(--gradient-hero);
    transition: height var(--transition-normal);
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(79, 70, 229, 0.2);
  }

  .blog-card:hover::before {
    height: 100%;
  }

  .blog-date {
    font-size: 0.85rem;
    color: var(--color-text-light);
    font-weight: 600;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .blog-card-title {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    transition: color var(--transition-fast);
  }

  .blog-card:hover .blog-card-title {
    color: var(--color-primary);
  }

  .blog-card-excerpt {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-read-more {
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-primary);
  }

  .blog-read-more svg {
    transition: transform var(--transition-fast);
  }

  .blog-card:hover .blog-read-more svg {
    transform: translateX(4px);
  }
</style>
