---
interface Props {
  footerPages: {
    id: string,
    title: string,
  },
  base: string,
}

const { footerPages, base } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div>
      <div class="footer-logo" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
        <img src={`${base}logo.png`} alt="TUKUJU Logo" style="height: 2.75rem; width: auto; object-fit: contain;" />
        <div style="display: flex; flex-direction: column; line-height: 1.1; justify-content: center;">
          <span style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 800; color: white;">Tudorfer Kulturverein</span>
          <span style="font-family: var(--font-body); font-size: 0.65rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.05em; text-transform: uppercase; margin-top: 0.1rem; display: block; white-space: nowrap;">für junge Unterhaltung e.V.</span>
        </div>
      </div>
      <p style="color: #64748b; margin-top: 0.5rem; font-size: 0.85rem;">Die besten in Events in Tudorf seit 1996</p>
    </div>
    <ul class="footer-nav">
      <li><a href={base} class="footer-link">Home</a></li>
      {footerPages.map(page => (
        <li><a href={`${base}${page.id}`} class="footer-link">{page.data.title}</a></li>
      ))}
    </ul>
    <div class="footer-copy">
      &copy; {currentYear} Tudorfer Kulturverein.
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 4rem 0;
    margin-top: auto;
    border-top: 1px solid #1e293b;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-logo {
    color: white;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link {
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .footer-link:hover {
    color: white;
  }

  .footer-copy {
    font-size: 0.85rem;
  }
</style>
