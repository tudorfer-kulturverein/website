---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tudorfer Kulturverein - Fostering community, culture, and traditions." } = Astro.props;

// Fetch all pages dynamically for the navbar
const allPages = (await getCollection('pages'))
  .sort((a, b) => a.data.order - b.data.order);

// Determine if we are on a page to add "active" class
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Helper to check active state
const isActiveLink = (path: string) => {
  // Normalize both paths by removing trailing slashes
  const p1 = path.endsWith('/') ? path.slice(0, -1) : path;
  const p2 = currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
  return p1 === p2;
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Tudorfer Kulturverein</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-container">
        <a href={base} class="logo" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;">
          <img src={`${base}logo.png`} alt="TUKUJU Logo" style="height: 3.2rem; width: auto; object-fit: contain;" />
          <div style="display: flex; flex-direction: column; line-height: 1.1; justify-content: center;">
            <span style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 800; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Tudorfer Kulturverein</span>
            <span style="font-family: var(--font-body); font-size: 0.72rem; font-weight: 700; color: var(--color-primary); letter-spacing: 0.05em; text-transform: uppercase; margin-top: 0.1rem; display: block; white-space: nowrap;">für junge Unterhaltung e.V.</span>
          </div>
        </a>
        <nav>
          <ul class="nav-list">
            <li>
              <a href={base} class={isActiveLink(base) ? 'nav-link active' : 'nav-link'}>
                Home
              </a>
            </li>
            {allPages.map(page => {
              const href = `${base}${page.id}`;
              return (
                <li>
                  <a href={href} class={isActiveLink(href) ? 'nav-link active' : 'nav-link'}>
                    {page.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-container">
        <div>
          <div class="footer-logo" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
            <img src={`${base}logo.png`} alt="TUKUJU Logo" style="height: 2.75rem; width: auto; object-fit: contain;" />
            <div style="display: flex; flex-direction: column; line-height: 1.1; justify-content: center;">
              <span style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 800; color: white;">Tudorfer Kulturverein</span>
              <span style="font-family: var(--font-body); font-size: 0.65rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.05em; text-transform: uppercase; margin-top: 0.1rem; display: block; white-space: nowrap;">für junge Unterhaltung e.V.</span>
            </div>
          </div>
          <p style="color: #64748b; margin-top: 0.5rem; font-size: 0.85rem;">Fostering culture and community since 1998.</p>
        </div>
        <ul class="footer-nav">
          <li><a href={base} class="footer-link">Home</a></li>
          {allPages.map(page => (
            <li><a href={`${base}${page.id}`} class="footer-link">{page.data.title}</a></li>
          ))}
          <li><a href={`${base}admin`} class="footer-link">Login</a></li>
        </ul>
        <div class="footer-copy">
          &copy; {new Date().getFullYear()} Tudorfer Kulturverein. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
