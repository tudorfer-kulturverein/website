---
import { getCollection } from 'astro:content';
import Navbar from '../components/Navbar.svelte';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tudorfer Kulturverein - Fostering community, culture, and traditions." } = Astro.props;

// Fetch all pages dynamically for the navbar
const allPages = await getCollection('pages');
const footerPages = allPages.filter(page => page.data.inFooter);

// Determine if we are on a page to add "active" class
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

// Helper to check active state
const isActiveLink = (path: string) => {
  // Normalize both paths by removing trailing slashes
  const p1 = path.endsWith('/') ? path.slice(0, -1) : path;
  const p2 = currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
  return p1 === p2;
};

// Tree layout interface for sub-menus
interface NavItem {
  title: string;
  href: string;
  isDropdown: boolean;
  order: number;
  children?: { title: string; href: string; order: number; }[];
}

const navItems: NavItem[] = [];

// Group pages by parent directory structure (e.g. parent/child)
const groups: Record<string, typeof allPages> = {};
const rootPages: typeof allPages = [];

allPages.filter(page => page.data.inNav).forEach(page => {
  const parts = page.id.split('/');
  if (parts.length > 1) {
    const parentSlug = parts[0];
    if (!groups[parentSlug]) {
      groups[parentSlug] = [];
    }
    groups[parentSlug].push(page);
  } else {
    rootPages.push(page);
  }
});

// Process folders as dropdown items
Object.keys(groups).forEach(parentSlug => {
  // Check if there is an exact root-level page matching this parent slug (e.g. showtanz-contest.md)
  const matchingRoot = rootPages.find(p => p.id === parentSlug);

  const children = groups[parentSlug].map(child => ({
    title: child.data.title,
    href: `${base}${child.id}`,
    order: child.data.order,
  })).sort((p1, p2) => p1.order - p2.order);

  if (matchingRoot) {
    children.unshift({
      title: matchingRoot.data.root_title || "Info",
      href: `${base}${matchingRoot.id}`,
      order: -1,
    });

    navItems.push({
      title: matchingRoot.data.title,
      href: `${base}${matchingRoot.id}`,
      isDropdown: true,
      order: matchingRoot.data.order,
      children
    });
    // Remove from roots so it isn't listed twice
    const index = rootPages.indexOf(matchingRoot);
    if (index > -1) {
      rootPages.splice(index, 1);
    }
  } else {
    // Format folder name (e.g. showtanz-contest -> Showtanz Contest)
    const formattedTitle = parentSlug
      .split('-')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');

    navItems.push({
      title: formattedTitle,
      href: '#',
      isDropdown: true,
      order: -1,
      children
    });
  }
});

// Add remaining normal root pages
rootPages.forEach(page => {
  navItems.push({
    title: page.data.title,
    href: `${base}${page.id}`,
    order: page.data.order,
    isDropdown: false
  });
});

navItems.sort((p1, p2) => p1.order - p2.order);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Tudorfer Kulturverein</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Navbar navItems={navItems} base={base} currentPath={currentPath} client:load />

    <slot />

    <footer class="site-footer">
      <div class="container footer-container">
        <div>
          <div class="footer-logo" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
            <img src={`${base}logo.png`} alt="TUKUJU Logo" style="height: 2.75rem; width: auto; object-fit: contain;" />
            <div style="display: flex; flex-direction: column; line-height: 1.1; justify-content: center;">
              <span style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 800; color: white;">Tudorfer Kulturverein</span>
              <span style="font-family: var(--font-body); font-size: 0.65rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.05em; text-transform: uppercase; margin-top: 0.1rem; display: block; white-space: nowrap;">für junge Unterhaltung e.V.</span>
            </div>
          </div>
          <p style="color: #64748b; margin-top: 0.5rem; font-size: 0.85rem;">Fostering culture and community since 1998.</p>
        </div>
        <ul class="footer-nav">
          <li><a href={base} class="footer-link">Home</a></li>
          {footerPages.map(page => (
            <li><a href={`${base}${page.id}`} class="footer-link">{page.data.title}</a></li>
          ))}
        </ul>
        <div class="footer-copy">
          &copy; {new Date().getFullYear()} Tudorfer Kulturverein. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
