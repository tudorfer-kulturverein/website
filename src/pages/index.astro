---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.svelte';

import heroData from '../data/hero.json';
const heroImages = heroData.images;

// Fetch all blog posts and sort by date descending
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Formatter for publication date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout title="Home" description="Welcome to Tudorfer Kulturverein - your community portal for arts, culture, and events. Browse our latest blog posts and club updates.">
  <main>
    <!-- Hero Section -->
    <section class="hero" style="padding-bottom: 0;">
      <div class="hero-glow"></div>
      <div class="hero-overlay"></div>
      <div class="container hero-content" style="margin-bottom: 4rem;">
        <span class="hero-tag">Welcome to our community</span>
        <h1 class="hero-title" style="margin-bottom: 0.25rem;">Tudorfer Kulturverein</h1>
        <div style="font-family: var(--font-body); font-size: 1.1rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem;">
          für junge Unterhaltung e.V.
        </div>
        <p class="hero-description" style="margin-bottom: 0;">
          Fostering culture, arts, local heritage, and community connection. Read our latest stories, news, and project announcements below.
        </p>
      </div>
      <div style="width: 100%; position: relative; z-index: 2;">
        <HeroCarousel client:load images={heroImages} />
      </div>
    </section>

    <!-- Blog Section -->
    <section id="blog-section" class="container section-padding">
      <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem;">
        <h2 style="margin-bottom: 1rem;">Latest Updates</h2>
        <p>Stay up to date with the latest projects, event schedules, and announcements from our club members.</p>
      </div>

      {sortedPosts.length === 0 ? (
        <p style="text-align: center; color: var(--color-text-light); font-style: italic; margin-top: 3rem;">
          No blog posts found. Check back later or create one via the CMS!
        </p>
      ) : (
        <div class="blog-grid">
          {sortedPosts.map((post) => (
            <article class="blog-card">
              <div class="blog-date">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {formatDate(post.data.date)}
              </div>
              <h3 class="blog-card-title">{post.data.title}</h3>
              <p class="blog-card-excerpt">{post.data.description}</p>
              <a href={`${import.meta.env.BASE_URL}blog/${post.id}`} class="blog-read-more">
                Read Article
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
